[
  {"id": "init_roundtrip", "feature": "pecli.file_roundtrip",
   "description": "init creates an empty store: byte-exact 16-byte file",
   "steps": [{"args": ["init", "store.dat"]}]},
  {"id": "add_get_list", "feature": "pecli.add_get_list",
   "description": "init, add three records, get one, list all; final file byte-exact",
   "steps": [{"args": ["init", "store.dat"]},
             {"args": ["add", "store.dat", "alpha", "one"]},
             {"args": ["add", "store.dat", "beta", "two words here"]},
             {"args": ["add", "store.dat", "gamma", "3"]},
             {"args": ["get", "store.dat", "beta"]},
             {"args": ["list", "store.dat"]}]},
  {"id": "update_and_remove", "feature": "pecli.update_remove",
   "description": "replace an existing key, remove another, list; final file byte-exact",
   "files": {"store.dat": {"from_original": "sample.dat"}},
   "steps": [{"args": ["add", "store.dat", "level", "99"]},
             {"args": ["remove", "store.dat", "owner"]},
             {"args": ["list", "store.dat"]}]},
  {"id": "checksum_sample", "feature": "pecli.checksum",
   "description": "checksum of the shipped sample.dat; file unchanged",
   "files": {"sample.dat": {"from_original": "sample.dat"}},
   "steps": [{"args": ["checksum", "sample.dat"]},
             {"args": ["list", "sample.dat"]}]},
  {"id": "err_bad_magic", "feature": "pecli.error_bad_magic",
   "description": "file with wrong magic: exit 2, message on stderr, file untouched",
   "files": {"bad.dat": {"text": "NOPE this is not a pcli save file at all\n"}},
   "steps": [{"args": ["list", "bad.dat"]},
             {"args": ["add", "bad.dat", "k", "v"]}]},
  {"id": "err_missing_file", "feature": "pecli.error_missing_file",
   "description": "missing file: exit 3; no file is created",
   "steps": [{"args": ["get", "nothere.dat", "k"]},
             {"args": ["list", "nothere.dat"]},
             {"args": ["checksum", "nothere.dat"]}]},
  {"id": "err_corrupt_crc", "feature": "pecli.error_corrupt",
   "description": "valid header but a flipped record byte: CRC mismatch, exit 4",
   "files": {"corrupt.dat": {"from_original": "sample.dat", "flip_byte": 30}},
   "steps": [{"args": ["list", "corrupt.dat"]},
             {"args": ["checksum", "corrupt.dat"]}]},
  {"id": "err_key_not_found_and_usage", "feature": "pecli.error_usage",
   "description": "missing key exits 1; unknown command and no args print usage and exit 1",
   "files": {"store.dat": {"from_original": "sample.dat"}},
   "steps": [{"args": ["get", "store.dat", "absent"]},
             {"args": ["remove", "store.dat", "absent"]},
             {"args": ["frobnicate", "store.dat"]},
             {"args": []}]}
]
