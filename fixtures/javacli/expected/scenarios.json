{
  "fixture": "javacli",
  "launcher": [
    "java",
    "-jar",
    "{ORIG}/javacli.jar"
  ],
  "newline_policy": "stdout/stderr always LF (explicit \n in the program, never println)",
  "observable_on": "host_via_java17",
  "oracle": {
    "certifying": false,
    "note": "Original jar executed with `java -jar` (JDK 17.0.20.1 on Windows 11, native). Native Windows execution of the jar is the real target, but the launcher javacli.cmd is not exercised.",
    "observable_on": "host_via_java17",
    "runner": "java17"
  },
